const admin = require('firebase-admin');

// Inicializa o Firebase Admin usando as credenciais do seu projeto
if (!admin.apps.length) {
    admin.initializeApp({
        credential: admin.credential.cert({
            projectId: "playfilmesplusofc",
            clientEmail: "firebase-adminsdk-fbsvc@playfilmesplusofc.iam.gserviceaccount.com",
            privateKey: process.env.FIREBASE_PRIVATE_KEY.replace(/\\n/g, '\n')
        }),
        storageBucket: "playfilmesplusofc.firebasestorage.app"
    });
}

exports.handler = async (event) => {
    try {
        const filePath = event.queryStringParameters.file;
        if (!filePath) {
            return { statusCode: 400, body: JSON.stringify({ error: "Caminho do arquivo não informado." }) };
        }

        const bucket = admin.storage().bucket();
        const file = bucket.file(filePath);

        // Define a expiração para 5 horas a partir de agora
        const options = {
            version: 'v4',
            action: 'read',
            expires: Date.now() + 5 * 60 * 60 * 1000, 
        };

        // Gera a URL temporária
        const [url] = await file.getSignedUrl(options);

        return {
            statusCode: 200,
            body: JSON.stringify({ downloadUrl: url })
        };
    } catch (error) {
        return {
            statusCode: 500,
            body: JSON.stringify({ error: error.message })
        };
    }
};
